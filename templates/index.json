0;\n      align-self: center;\n      margin: 0;\n    }\n    .cm-ti__d {\n      max-width: 270px;\n    }\n  }\n</style>\n\n<div class=\"cm-ti\">\n  <div class=\"cm-ti__inner\">\n\n<!-- GRATIS VERZENDING -->\n<div class=\"cm-ti__item\">\n  <div class=\"cm-ti__img\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0851/6652/2593/files/download.png?v=1788442628\" alt=\"Gratis verzending met PostNL\" loading=\"lazy\" width=\"64\" height=\"64\">\n  </div>\n  <h5 class=\"cm-ti__h\">\n    Gratis verzending met PostNL\n  </h5>\n  <p class=\"cm-ti__d\">\n    Wij verzenden uw bestelling snel en veilig met PostNL. Gratis verzending op alle bestellingen.\n  </p>\n</div>\n\n<div class=\"cm-ti__div\"></div>\n\n<!-- VEILIG BETALEN -->\n<div class=\"cm-ti__item\">\n  <div class=\"cm-ti__img\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0851/6652/2593/files/2.avif?v=1788442713\" alt=\"Veilig betalen\" loading=\"lazy\" width=\"64\" height=\"64\">\n  </div>\n  <h5 class=\"cm-ti__h\">\n    Veilig betalen\n  </h5>\n  <p class=\"cm-ti__d\">\n    Uw betaling wordt beschermd met moderne beveiligingstechnologie, zodat u met een gerust hart kunt winkelen.\n  </p>\n</div>\n\n<div class=\"cm-ti__div\"></div>\n\n<!-- 30 DAGEN GELD-TERUG-GARANTIE -->\n<div class=\"cm-ti__item\">\n  <div class=\"cm-ti__img\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0851/6652/2593/files/1.avif?v=1788442713\" alt=\"30 dagen geld-terug-garantie\" loading=\"lazy\" width=\"64\" height=\"64\">\n  </div>\n  <h5 class=\"cm-ti__h\">\n    30 dagen geld-terug-garantie\n  </h5>\n  <p class=\"cm-ti__d\">\n    Winkel met vertrouwen. U kunt uw bestelling binnen 30 dagen retourneren of omruilen als u niet tevreden bent.\n  </p>\n</div>\n\n  </div>\n</div>",
