    "custom_html_HWpjDf": {
      "type": "custom-html",
      "name": "Custom HTML",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "html": "<style>\n  .cm-ti {\n    padding: 10px 24px 58px;\n    background: #fafafa;\n  }\n  .cm-ti__inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: flex;\n    justify-content: center;\n    align-items: stretch;\n  }\n  .cm-ti__item {\n    flex: 1;\n    text-align: center;\n    padding: 0 54px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n  }\n  .cm-ti__img {\n    width: 64px;\n    height: 64px;\n    min-width: 64px;\n    margin: 0 auto;\n    border-radius: 50%;\n    border: 1px solid #e7e5e4;\n    background: #faf9f7;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n  .cm-ti__img img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    display: block;\n    padding: 13px;\n    box-sizing: border-box;\n  }\n  .cm-ti__h {\n    margin-top: 15px !important;\n    font-size: 12px;\n    font-weight: 700 !important;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    font-family: 'Montserrat', serif;\n    color: #590c0c;\n    margin-bottom: 12px !important;\n    line-height: 1.35;\n  }\n  .cm-ti__d {\n    font-family: 'Montserrat', sans-serif;\n    font-size: 12px;\n    line-height: 1.55;\n    font-weight: 400;\n    color: #8c817c;\n    margin: 0 auto;\n    max-width: 245px;\n  }\n  .cm-ti__div {\n    width: 1px;\n    background: #e7e5e4;\n    flex-shrink: 0;\n    align-self: stretch;\n    margin: 2px 0;\n  }\n\n  /* TABLETTE */\n  @media screen and (max-width: 900px) {\n    .cm-ti__item {\n      padding: 0 28px;\n    }\n  }\n\n  /* APPAREILS MOBILES */\n  @media screen and (max-width: 640px) {\n    .cm-ti {\n      padding: 42px 20px;\n    }\n    .cm-ti__inner {\n      flex-direction: column;\n      align-items: center;\n      gap: 28px;\n    }\n    .cm-ti__item {\n      width: 100%;\n      max-width: 320px;\n      padding: 0;\n    }\n    .cm-ti__div {\n      width: 60px;\n      height: 1px;\n      min-height: 0;\n      align-self: center;\n      margin: 0;\n    }\n    .cm-ti__d {\n      max-width: 270px;\n    }\n  }\n</style>\n\n<div class=\"cm-ti\">\n  <div class=\"cm-ti__inner\">\n\n    <!-- LIVRAISON GRATUITE AVEC LA POSTE -->\n    <div class=\"cm-ti__item\">\n      <div class=\"cm-ti__img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0851/6652/2593/files/images.jpg?v=1789492773\" alt=\"Livraison gratuite avec La Poste\" loading=\"lazy\" width=\"64\" height=\"64\">\n      </div>\n      <h5 class=\"cm-ti__h\">\n        Livraison gratuite avec La Poste\n      </h5>\n      <p class=\"cm-ti__d\">\n        Nous expédions votre commande rapidement et en toute sécurité avec La Poste. La livraison est gratuite pour toutes les commandes.\n      </p>\n    </div>\n\n    <div class=\"cm-ti__div\"></div>\n\n    <!-- PAIEMENTS SÉCURISÉS -->\n    <div class=\"cm-ti__item\">\n      <div class=\"cm-ti__img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0851/6652/2593/files/2.avif?v=1788442713\" alt=\"Paiements sécurisés\" loading=\"lazy\" width=\"64\" height=\"64\">\n      </div>\n      <h5 class=\"cm-ti__h\">\n        Paiements sécurisés\n      </h5>\n      <p class=\"cm-ti__d\">\n        Votre paiement est protégé par des technologies de sécurité modernes, vous permettant de faire vos achats en toute tranquillité.\n      </p>\n    </div>\n\n    <div class=\"cm-ti__div\"></div>\n\n    <!-- GARANTIE DE REMBOURSEMENT DE 30 JOURS -->\n    <div class=\"cm-ti__item\">\n      <div class=\"cm-ti__img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0851/6652/2593/files/1.avif?v=1788442713\" alt=\"Garantie de remboursement de 30 jours\" loading=\"lazy\" width=\"64\" height=\"64\">\n      </div>\n      <h5 class=\"cm-ti__h\">\n        Garantie de remboursement de 30 jours\n      </h5>\n      <p class=\"cm-ti__d\">\n        Faites vos achats en toute tranquillité. Si vous n'êtes pas satisfait, vous pouvez retourner ou échanger votre commande sous 30 jours.\n      </p>\n    </div>\n\n  </div>\n</div>",
