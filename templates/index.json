        "item_UPPXxM": {
          "type": "item",
          "settings": {
            "question": "Quel est le délai de livraison ?",
            "answer": "<p>Les produits en stock sont généralement livrés sous 6 à 9 jours ouvrés.</p>"
          }
        },
        "item_8dNpKA": {
          "type": "item",
          "settings": {
            "question": "Comment puis-je effectuer un retour ?",
            "answer": "<p>Si votre commande est éligible à un retour, vous pouvez nous envoyer un e-mail via la rubrique <strong>« Contact »</strong> de notre site internet.</p><p>Dans votre message, veuillez indiquer votre numéro de commande, le motif du retour, une photo du produit s’il est endommagé, ainsi que votre nom, votre prénom et votre adresse complète.</p><p>Nous vous contacterons ensuite pour vous communiquer l’adresse à laquelle retourner le produit.</p>"
          }
        },
        "item_VWRcJj": {
          "type": "item",
          "settings": {
            "question": "Comment vais-je recevoir mon remboursement ?",
            "answer": "<p>Le remboursement est toujours effectué via le même moyen de paiement que celui utilisé lors de l’achat. Si vous avez payé par carte bancaire, le montant des produits retournés sera directement recrédité sur cette même carte.</p>"
          }
        },
        "item_WRAeiK": {
          "type": "item",
          "settings": {
            "question": "Quels moyens de paiement sont acceptés ?",
            "answer": "<p>Vous pouvez choisir parmi les moyens de paiement suivants : <strong>carte bancaire (Visa, Mastercard, AMEX), Google Pay, Apple Pay et Bancontact.</strong></p>"
          }
        }
      },
