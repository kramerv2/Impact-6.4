: 0;\n      align-self: center;\n      margin: 0;\n    }\n    .cm-ti__d {\n      max-width: 270px;\n    }\n  }\n</style>\n\n<div class=\"cm-ti\">\n  <div class=\"cm-ti__inner\">\n\n\n<!-- ENTREGA GRÁTIS -->\n<div class=\"cm-ti__item\">\n  <div class=\"cm-ti__img\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0841/4743/7786/files/images.png?v=1787760342\"\n      alt=\"Entrega grátis com CTT\"\n      loading=\"lazy\"\n      width=\"64\"\n      height=\"64\"\n    >\n  </div>\n  <h5 class=\"cm-ti__h\">\n    Entrega grátis com CTT\n  </h5>\n  <p class=\"cm-ti__d\">\n    Enviamos a sua encomenda de forma rápida e segura com os CTT. Entrega grátis em todas as encomendas.\n  </p>\n</div>\n\n<div class=\"cm-ti__div\"></div>\n\n<!-- PAGAMENTO SEGURO -->\n<div class=\"cm-ti__item\">\n  <div class=\"cm-ti__img\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0841/4743/7786/files/2.avif?v=1787760248\"\n      alt=\"Pagamento seguro\"\n      loading=\"lazy\"\n      width=\"64\"\n      height=\"64\"\n    >\n  </div>\n  <h5 class=\"cm-ti__h\">\n    Pagamento seguro\n  </h5>\n  <p class=\"cm-ti__d\">\n    O seu pagamento está protegido por tecnologia de segurança moderna, para que possa comprar com toda a confiança.\n  </p>\n</div>\n\n<div class=\"cm-ti__div\"></div>\n\n<!-- GARANTIA DE 30 DIAS -->\n<div class=\"cm-ti__item\">\n  <div class=\"cm-ti__img\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0841/4743/7786/files/1.avif?v=1787760248\"\n      alt=\"Garantia de reembolso de 30 dias\"\n      loading=\"lazy\"\n      width=\"64\"\n      height=\"64\"\n    >\n  </div>\n  <h5 class=\"cm-ti__h\">\n    Garantia de reembolso de 30 dias\n  </h5>\n  <p class=\"cm-ti__d\">\n    Compre com confiança. Pode devolver ou trocar a sua encomenda no prazo de 30 dias, caso não fique satisfeito.\n  </p>\n</div>\n\n\n  </div>\n</div>",
