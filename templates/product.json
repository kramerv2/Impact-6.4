    "testimonials_keBKgy": {
      "type": "testimonials",
      "blocks": {
        "testimonial_Vh6ALa": {
          "type": "testimonial",
          "settings": {
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Ruth · vor 4 Tagen",
            "title": "Mega freundlicher Service",
            "content": "<p>Hab eine Frage zu meiner Bestellung gehabt und innerhalb von Minuten schon Antwort bekommen. Sehr nett und hilfsbereit, man merkt einfach dass es ihnen wichtig ist. Lieferung war auch super schnell, bin total zufrieden!</p>"
          }
        },
        "testimonial_eRmK6D": {
          "type": "testimonial",
          "settings": {
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Heidi · vor 1 Woche",
            "title": "Schön verpackt und top Qualität",
            "content": "<p>Also ich muss sagen, ich war fasch positiv überrascht. Das Päckli ist mega schön verpackt angekommen, fast schad zum aufmache 😄 Und die Qualität vom Stoff ist wirklich top. Komm sicher wieder!</p>"
          }
        },
        "testimonial_qhW3rC": {
          "type": "testimonial",
          "settings": {
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Verena · vor 2 Tagen",
            "title": "Passt einfach perfekt",
            "content": "<p>Hab lang gesucht für sowas und endlich gfunde bi ELINORA. Sitzt mega guet, und de Stoff fühlt sich nöd billig a, im Gägeteil. Han scho komplimänt becho dafür. Bin happy!</p>"
          }
        },
        "testimonial_Xh4Vyf": {
          "type": "testimonial",
          "settings": {
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Trudi · vor 6 Stunden",
            "title": "Top Qualität, gärn wieder",
            "content": "<p>Bin echt begeisteret vo mim Outfit. Me merkt dass da Herzblut dranne isch, jedes Detail stimmt. Au de Versand het problemlos klappt. Klare Empfehlung vo mir!</p>"
          }
        },
        "testimonial_hiD6VE": {
          "type": "testimonial",
          "settings": {
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Margrit · vor 1 Woche",
            "title": "Hat sich definitiv glohnt",
            "content": "<p>Bi zerst chli skeptisch gsi, knapp 200 Fr. für ä Chleid vor mer nie ghört hatt. Aber ich bereue nüt! Qualität top, passt perfekt. Danke Eli und Nora, han mega Freud dra.</p>"
          }
        },
        "testimonial_QnF4ah": {
          "type": "testimonial",
          "disabled": true,
          "settings": {
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Margrit T.",
            "title": "Genau mein Stil",
            "content": "<p>Ich bin nicht einfach zu kleiden – ich mag es schlicht aber trotzdem besonders. Diese Bluse trifft es genau. Sitzt gut, sieht elegant aus und ist bequem für den ganzen Tag. Sehr zufrieden.</p>"
          }
        }
