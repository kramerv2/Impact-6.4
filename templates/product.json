          "settings": {
            "liquid": "<div id=\"shipping-status\" style=\"display: flex; justify-content: space-between; align-items: center; background-color: #f5f5f5; padding: 8px 0; width: 100%; box-sizing: border-box; margin-top: -20px;\">\n  <div style=\"display: flex; align-items: center; flex-shrink: 1; min-width: 0; padding-left: 12px;\">\n    <div id=\"dot\" style=\"width: 8px; height: 8px; background-color: #009246; border-radius: 50%; margin-right: 8px; flex-shrink: 0; transition: opacity 0.5s ease;\"></div>\n    <span class=\"verzonden-text\" style=\"font-size: 12px; color: #333; font-weight: 300;\">Versendet</span>\n    <span id=\"shippingDate\" class=\"shipping-date\" style=\"font-size: 12px; color: #000; font-weight: 600; margin-left: 4px;\"></span>\n  </div>\n  <div style=\"display: flex; align-items: center; flex-shrink: 0; margin-left: 8px; padding-right: 12px;\">\n    <!-- Swiss flag -->\n    <img class=\"flag-ch\" src=\"https://cdn.shopify.com/s/files/1/0987/7792/3933/files/32px-Flag_orb_Switzerland_svg.png?v=1758210124\" alt=\"Swiss Flag\" style=\"width: 16px; height: 16px; margin-right: 4px; flex-shrink: 0; object-fit: contain;\">\n    <span class=\"snelle-text\" style=\"font-size: 12px; color: #000; font-weight: 600;\">Schnelle Lieferung</span>\n  </div>\n</div>\n<style>\n  /* Mobile optimization for screens smaller than 360px */\n  @media (max-width: 360px) {\n    .verzonden-text, .shipping-date, .snelle-text {\n      font-size: 10px !important;\n    }\n    .flag-ch {\n      width: 12px !important;\n      height: 12px !important;\n    }\n    #dot {\n      width: 6px !important;\n      height: 6px !important;\n    }\n  }\n</style>\n<script>\n  function getNextDayDate() {\n    const days = ['So.', 'Mo.', 'Di.', 'Mi.', 'Do.', 'Fr.', 'Sa.'];\n    const date = new Date();\n    \n    // Convert to Swiss timezone (CET/CEST)\n    const swissTime = new Date(date.toLocaleString(\"en-US\", {timeZone: \"Europe/Zurich\"}));\n    swissTime.setDate(swissTime.getDate() + 1);\n    \n    const dayName = days[swissTime.getDay()];\n    const dayOfMonth = swissTime.getDate().toString().padStart(2, '0');\n    const month = (swissTime.getMonth() + 1).toString().padStart(2, '0');\n    return `${dayName} ${dayOfMonth}/${month}`;\n  }\n  \n  document.getElementById('shippingDate').textContent = getNextDayDate();\n  \n  // Fading effect using opacity\n  const dot = document.getElementById('dot');\n  let fadeOut = true;\n  \n  function fadeDot() {\n    if (fadeOut) {\n      dot.style.opacity = '0.5';\n    } else {\n      dot.style.opacity = '1';\n    }\n    fadeOut = !fadeOut;\n  }\n  \n  setInterval(fadeDot, 1000);\n</script>"
          }
