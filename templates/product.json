e() + 1);\n    \n    const dayName = days[dkTime.getDay()];\n    const dayOfMonth = dkTime.getDate().toString().padStart(2, '0');\n    const month = (dkTime.getMonth() + 1).toString().padStart(2, '0');\n    return `${dayName} ${dayOfMonth}/${month}`;\n  }\n  \n  document.getElementById('shippingDate').textContent = getNextDayDate();\n  \n  // Fading effect using opacity\n  const dot = document.getElementById('dot');\n  let fadeOut = true;\n  \n  function fadeDot() {\n    dot.style.opacity = fadeOut ? '0.5' : '1';\n    fadeOut = !fadeOut;\n  }\n  \n  setInterval(fadeDot, 1000);\n</script>"
