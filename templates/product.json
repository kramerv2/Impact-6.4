NEFITS\n   Fully scoped so it won't affect Shopify\n========================================= */\n\n.trust-benefits {\n  width: 100%;\n  max-width: 390px;\n\n  display: flex;\n  flex-direction: column;\n  gap: 13px;\n\n  padding: 4px 0;\n\n  font-family: Arial, Helvetica, sans-serif;\n}\n\n\n/* EACH ROW */\n\n.trust-benefits .trust-benefit {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n\n/* ROUND ICON */\n\n.trust-benefits .trust-benefit__icon {\n  width: 42px;\n  height: 42px;\n  min-width: 42px;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  border-radius: 50%;\n  border: 1px solid #e7e2df;\n\n  background: #faf9f8;\n}\n\n\n/* SVG ICON */\n\n.trust-benefits .trust-benefit__icon svg {\n  width: 19px;\n  height: 19px;\n\n  fill: none;\n\n  stroke: #74110c;\n  stroke-width: 1.25;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* TEXT AREA */\n\n.trust-benefits .trust-benefit__content {\n  display: flex;\n  flex-direction: column;\n\n  justify-content: center;\n  align-items: flex-start;\n\n  text-align: left;\n\n  min-width: 0;\n}\n\n\n/* HEADING */\n\n.trust-benefits .trust-benefit__title {\n  width: 100%;\n\n  margin: 0 0 3px 0;\n\n  color: #74110c;\n\n  font-size: 13px;\n  line-height: 1.1;\n  font-weight: 700;\n\n  letter-spacing: 0.35px;\n\n  text-transform: uppercase;\n\n  text-align: left;\n}\n\n\n/* SUBTEXT */\n\n.trust-benefits .trust-benefit__text {\n  width: 100%;\n\n  margin: 0;\n\n  color: #b18b86;\n\n  font-size: 12px;\n  line-height: 1.2;\n  font-weight: 400;\n\n  letter-spacing: 0.35px;\n\n  text-align: left;\n}\n\n\n/* MOBILE */\n\n@media screen and (max-width: 749px) {\n\n  .trust-benefits {\n    gap: 13px;\n  }\n\n  .trust-benefits .trust-benefit__icon {\n    width: 40px;\n    height: 40px;\n    min-width: 40px;\n  }\n\n  .trust-benefits .trust-benefit__icon svg {\n    width: 18px;\n    height: 18px;\n  }\n\n  .trust-benefits .trust-benefit__title {\n    font-size: 12.5px;\n  }\n\n  .trus