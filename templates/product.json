\n    overflow: hidden;\n  }\n\n  #cm-customer-gallery .cm-gal__img img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  #cm-customer-gallery .cm-gal__name {\n    font-family: 'Playfair Display', Georgia, serif;\n    font-style: italic;\n    font-size: 19px;\n    color: #590c0c;\n    text-align: center;\n    padding: 15px;\n    margin: 0;\n    border-top: 1px solid #f3f1ec;\n  }\n\n  #cm-customer-gallery .cm-gal__arrow {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    z-index: 5;\n\n    width: 40px;\n    height: 40px;\n\n    padding: 0;\n\n    border-radius: 50%;\n    background: rgba(255,255,255,0.92);\n    border: 1px solid #eceae4;\n\n    box-shadow: 0 2px 8px rgba(0,0,0,0.12);\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    cursor: pointer;\n    color: #590c0c;\n  }\n\n  #cm-customer-gallery .cm-gal__arrow--l {\n    left: 2px;\n  }\n\n  #cm-customer-gallery .cm-gal__arrow--r {\n    right: 2px;\n  }\n\n  #cm-customer-gallery .cm-gal__arrow svg {\n    width: 22px;\n    height: 22px;\n  }\n\n  @media screen and (max-width: 640px) {\n\n    #cm-customer-gallery .cm-gal {\n      padding: 40px 0;\n    }\n\n    #cm-customer-gallery .cm-gal__head {\n      margin-bottom: 28px;\n    }\n\n    #cm-customer-gallery .cm-gal__sub {\n      font-size: 12px;\n    }\n\n    #cm-customer-gallery .cm-gal__h {\n      font-size: 23px;\n    }\n\n    #cm-customer-gallery .cm-gal__card {\n      width: 260px;\n      flex: 0 0 260px;\n    }\n\n    #cm-customer-gallery .cm-gal__track {\n      padding-left: 20px;\n      padding-right: 20px;\n    }\n\n    #cm-customer-gallery .cm-gal__arrow {\n      width: 36px;\n      height: 36px;\n    }\n  }\n</style>\n\n<div id=\"cm-customer-gallery\">\n\n  <div class=\"cm-gal\">\n\n\n<!-- TÍTULO -->\n<div class=\"cm-gal__head\">\n\n  <p class=\"cm-gal__sub\">\n    A nossa comunidade\n  </p>\n\n  <h2 class=\"cm-gal__h\">\n    Clientes usam Carla 