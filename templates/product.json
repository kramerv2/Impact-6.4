    "testimonials_keBKgy": {
      "type": "testimonials",
      "blocks": {
        "testimonial_Vh6ALa": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/review_4_180x_b5e39700-1b24-4f9c-a0e8-ed0687429a38.webp",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Mette V. - København – For 2 uger siden",
            "title": "Det var virkelig det værd!",
            "content": "<p>Jeg tøvede lidt med at bruge 1.100 kr. på en kjole fra en butik, hvor jeg aldrig havde bestilt før, men jeg er så glad for, at jeg gjorde det. Kvaliteten er enestående, og pasformen er helt perfekt.</p>"
          }
        },
        "testimonial_eRmK6D": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/review_6_180x_c92e624c-46af-43ba-9d21-eef8153ffd87.avif",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Sofie K. - Aarhus - For 3 dage siden",
            "title": "Perfekt størrelse!",
            "content": "<p>Disse flotte trøjer passer præcis som lovet, og stoffet er behageligt — det kradser slet ikke! Deres sans for kvalitet er virkelig imponerende.</p>"
          }
        },
        "testimonial_qhW3rC": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/review_8_180x_6064ec30-9aaf-49e5-b7c4-c65d78567466.webp",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Lene D. - Odense – For 2 måneder siden",
            "title": "Upåklagelig finish!",
            "content": "<p>Et robust, luksuriøst stof af høj kvalitet med en perfekt pasform. Trøjen falder smukt, og finishen er gennemført ned til mindste detalje.</p>"
          }
        },
        "testimonial_Xh4Vyf": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/review_5_180x_d9522fbe-fb52-4e40-9ca4-cc4fd68a0ed3.avif",
            "round_avatar": true,
            "show_rating": true,
            "rating": 4,
            "author": "Anne J. - Frederiksberg – For 2 dage siden",
            "title": "Enestående kvalitet og smukt håndværk",
            "content": "<p>Stoffet er af høj kvalitet, og farven svarer præcis til billedet. Den sad blot lidt strammere over skuldrene, end jeg havde forventet. Samlet set er jeg dog meget tilfreds med mit køb.</p>"
          }
        },
        "testimonial_WxMcXk": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/review_2_180x_3611e2ac-cfe4-4dea-9ef9-bc669f71c31f.avif",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Freja P. - Aalborg – For 3 dage siden",
            "title": "Hurtig levering",
            "content": "<p>Jeg har allerede bestilt tre gange, og jeg er stadig lige begejstret. Kjolerne er smukke, og kundeservicen er fremragende med personlig hjælp til at vælge den rigtige størrelse.</p>"
          }
        },
        "testimonial_BWDJAm": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/review_3_180x_26e79044-ff3a-4b26-96c1-5e1ef9cddf95.avif",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Flatterende pasform, topkvalitet.",
            "title": "Ida M. - Esbjerg – For 5 dage siden",
            "content": "<p>Jeg er virkelig tilfreds. Kvaliteten er i top, og det kan mærkes med det samme, når man har den på. Pasformen er flatterende uden at være for stram, og stoffet er behageligt hele dagen. Det er sådan et stykke tøj, man nemt tager på igen og igen.</p>"
          }
        },
        "testimonial_8BjiD9": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/review_1_180x_5ab612a7-0bff-4576-967b-a239c6cbe6fd.avif",
            "round_avatar": true,
            "show_rating": true,
            "rating": 5,
            "author": "Emma T. - Roskilde – For 8 måneder siden",
            "title": "Som beskrevet, upåklagelig kvalitet.",
            "content": "<p>Bestillingen kom fint frem, og alt var meget godt pakket og omhyggeligt behandlet. Tøjet svarer til billederne, og kvaliteten lever virkelig op til forventningerne. Jeg er meget tilfreds med mit køb og vil uden tvivl anbefale det.</p>"
          }
        }
      },
