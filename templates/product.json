 font-weight: 600;\n            border-left: 3px solid #2c767e;\n            color: #000;\n        }\n        .note {\n            font-size: 0.8rem;\n            color: #666;\n            font-weight: 600;\n            text-align: center;\n            width: 100%;\n        }\n        @media (min-width: 640px) {\n            .sale-banner {\n                padding: 28px 24px;\n            }\n            .banner-title {\n                font-size: 2.2rem;\n                white-space: normal;\n            }\n            .discount {\n                font-size: 1.3rem;\n            }\n            .offers {\n                flex-direction: row;\n                justify-content: center;\n                gap: 16px;\n            }\n            .offer-item {\n                font-size: 0.95rem;\n            }\n        }\n        @media (min-width: 768px) {\n            .banner-title {\n                font-size: 2.5rem;\n            }\n            .discount {\n                font-size: 1.4rem;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"sale-banner\">\n        <div class=\"banner-subtitle\">— Offerta speciale —</div>\n        <div class=\"banner-title\">SALDI VESTIRI</div>\n        <div class=\"discount\">Fino al 70% di sconto · Solo fino ad esaurimento scorte</div>\n        <div class=\"offers\">\n            <div class=\"offer-item\">15% extra acquistando 2 prodotti</div>\n            <div class=\"offer-item\">20% extra acquistando 3 prodotti</div>\n            <div class=\"offer-item\">25% extra acquistando 4+ prodotti</div>\n        </div>\n        <div class=\"note\">Pulsante cliccabile = ancora disponibile</div>\n    </div>\n</body>\n</html>"
